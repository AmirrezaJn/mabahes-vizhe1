<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>My Table</title>

    <style>
        body {
            background-color: #f4f5ed;
            font-family: Arial, sans-serif;
            text-align: center;
        }
        
        h2 {
            color: #556b2f;
            margin-top: 40px;
        }
        
        table {
            border-collapse: collapse;
            width: 60%;
            margin: 30px auto;
            background-color: white;
        }
        
        th {
            background-color: #556b2f;
            color: white;
            padding: 14px;
        }
        
        td {
            border: 1px solid #d4dcc4;
            padding: 12px;
            color: #333;
        }
        
        tr:nth-child(even) {
            background-color: #e8eddf;
        }
        
        tr:hover {
            background-color: #d4dfbd;
        }
    </style>
</head>

